<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shop All – Adore Heaven</title>
  <link rel="stylesheet" href="/css/index.css">
  <link rel="stylesheet" href="/css/products.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
</head>

<body class="products-page">

  <div>
    <p id="free-shipping">FREE SHIPPING ON ORDERS ABOVE RS. 3,500</p>
  </div>

  <div id="nav">
    <span class="material-symbols-outlined" id="hamburger">menu</span>
    <a href="/"><img src="/Assests/logo.jpeg" alt="logo"></a>
    <nav>
      <ul class="nav-links" id="nav-menu">
        <li><a href="/"         class="nav-links">Home</a></li>
        <li><a href="/products" class="nav-links">Shop All</a></li>
        <li><a href="#"         class="nav-links">Pandora Inspired</a></li>
        <li><a href="#"         class="nav-links">Earrings</a></li>
        <li><a href="#"         class="nav-links">Necklaces</a></li>
        <li><a href="#"         class="nav-links">Rings</a></li>
        <li><a href="#"         class="nav-links">Bracelets</a></li>
        <li><a href="#"         class="nav-links">New Arrivals</a></li>
        <li><a href="#"         class="nav-links">Sale</a></li>
      </ul>
    </nav>

    <!-- Auth nav links -->
    <div class="nav-auth-links">
      <% if (currentUser) { %>
        <span class="nav-username">Hi, <%= currentUser.name.split(' ')[0] %></span>
        <% if (currentUser.role === 'admin') { %>
          <a href="/admin" class="nav-auth-btn">Admin</a>
        <% } %>
        <a href="/logout" class="nav-auth-btn">Logout</a>
      <% } else { %>
        <a href="/login"    class="nav-auth-btn">Login</a>
        <a href="/register" class="nav-auth-btn">Register</a>
      <% } %>
    </div>

    <a href="#" class="icon"><span class="material-symbols-outlined">search</span></a>
    <a href="#" class="icon"><span class="material-symbols-outlined">shopping_bag</span></a>
  </div>

  <!-- Flash messages -->
  <% if (messages.success && messages.success.length > 0) { %>
    <div class="flash flash-success" style="margin:12px 5%;">
      <span class="material-symbols-outlined">check_circle</span>
      <%= messages.success[0] %>
    </div>
  <% } %>
  <% if (messages.error && messages.error.length > 0) { %>
    <div class="flash flash-error" style="margin:12px 5%;">
      <span class="material-symbols-outlined">error</span>
      <%= messages.error[0] %>
    </div>
  <% } %>

  <div class="products-hero">
    <h1>Our Collection</h1>
    <p><%= total %> pieces found</p>
  </div>

  <div class="products-layout">

    <aside class="filters-sidebar">
      <h2>Filters</h2>
      <form method="GET" action="/products" id="filter-form">

        <div class="filter-group">
          <label for="search">Search</label>
          <input type="text" id="search" name="search" placeholder="Search jewelry..." value="<%= query.search %>">
        </div>

        <div class="filter-group">
          <label for="category">Category</label>
          <select id="category" name="category">
            <option value="">All Categories</option>
            <% categories.forEach(function(cat) { %>
              <option value="<%= cat %>" <%= query.category === cat ? "selected" : "" %>><%= cat %></option>
            <% }); %>
          </select>
        </div>

        <div class="filter-group">
          <label>Price Range (PKR)</label>
          <div class="price-range-inputs">
            <input type="number" name="minPrice" placeholder="Min" min="0" value="<%= query.minPrice %>">
            <input type="number" name="maxPrice" placeholder="Max" min="0" value="<%= query.maxPrice %>">
          </div>
        </div>

        <input type="hidden" name="sort" id="hidden-sort" value="<%= query.sort %>">
        <button type="submit" class="btn-apply">Apply Filters</button>
        <a href="/products" class="btn-reset">Reset all</a>
      </form>
    </aside>

    <main class="products-main">

      <div class="products-toolbar">
        <span class="results-count">
          Showing <strong><%= products.length %></strong> of <strong><%= total %></strong> items
        </span>
        <div class="sort-wrapper">
          <label for="sort-select">Sort by:</label>
          <select id="sort-select" onchange="applySort(this.value)">
            <option value="default"    <%= query.sort === "default"    ? "selected" : "" %>>Featured</option>
            <option value="price_asc"  <%= query.sort === "price_asc"  ? "selected" : "" %>>Price: Low to High</option>
            <option value="price_desc" <%= query.sort === "price_desc" ? "selected" : "" %>>Price: High to Low</option>
            <option value="rating"     <%= query.sort === "rating"     ? "selected" : "" %>>Top Rated</option>
          </select>
        </div>
      </div>

      <div class="products-grid">
        <% if (products.length === 0) { %>
          <div class="no-results">
            <span class="icon">💎</span>
            <p>No products match your filters.</p>
            <a href="/products" class="btn-reset">Clear filters</a>
          </div>
        <% } %>

        <% products.forEach(function(product) { %>
          <div class="product-card">
            <% if (product.image) { %>
              <img src="<%= product.image %>" alt="<%= product.name %>" class="product-card-img">
            <% } else { %>
              <div class="product-card-img no-img">💎</div>
            <% } %>
            <div class="product-card-body">
              <span class="product-card-category"><%= product.category %></span>
              <h3 class="product-card-name"><%= product.name %></h3>
              <div class="product-card-rating">
                <% for (var i = 1; i <= 5; i++) { %>
                  <span class="star <%= i <= product.rating ? "" : "empty" %>">★</span>
                <% } %>
              </div>
              <div class="product-card-pricing">
                <span class="price-sale">Rs. <%= product.price.toLocaleString() %></span>
                <% if (product.prevPrice) { %>
                  <span class="price-prev">Rs. <%= product.prevPrice.toLocaleString() %></span>
                <% } %>
              </div>
              <span class="product-card-stock <%= product.stock <= 5 ? "low" : "" %>">
                <% if (product.stock === 0) { %>Out of stock
                <% } else if (product.stock <= 5) { %>Only <%= product.stock %> left!
                <% } else { %>In stock<% } %>
              </span>
            </div>
          </div>
        <% }); %>
      </div>

      <% if (totalPages > 1) { %>
        <nav class="pagination">
          <a href="/products?search=<%= query.search %>&category=<%= query.category %>&minPrice=<%= query.minPrice %>&maxPrice=<%= query.maxPrice %>&sort=<%= query.sort %>&page=<%= currentPage - 1 %>"
            class="page-btn <%= currentPage === 1 ? 'disabled' : '' %>">← Prev</a>

          <% for (var p = 1; p <= totalPages; p++) { %>
            <% if (p === 1 || p === totalPages || (p >= currentPage - 1 && p <= currentPage + 1)) { %>
              <a href="/products?search=<%= query.search %>&category=<%= query.category %>&minPrice=<%= query.minPrice %>&maxPrice=<%= query.maxPrice %>&sort=<%= query.sort %>&page=<%= p %>"
                class="page-btn <%= p === currentPage ? 'active' : '' %>"><%= p %></a>
            <% } else if (p === currentPage - 2 || p === currentPage + 2) { %>
              <span class="page-btn disabled">…</span>
            <% } %>
          <% } %>

          <a href="/products?search=<%= query.search %>&category=<%= query.category %>&minPrice=<%= query.minPrice %>&maxPrice=<%= query.maxPrice %>&sort=<%= query.sort %>&page=<%= currentPage + 1 %>"
            class="page-btn <%= currentPage === totalPages ? 'disabled' : '' %>">Next →</a>
        </nav>
      <% } %>

    </main>
  </div>

  <footer>
    <div class="footer">
      <div class="f-div">
        <h1>Our Brand</h1>
        <p>High quality jewelry at an affordable price. ❤︎</p>
      </div>
      <div class="f-div">
        <h1>Quick Shop</h1>
        <a href="/"         class="f-link">Home</a>
        <a href="/products" class="f-link">Shop All</a>
        <a href="#"         class="f-link">Earrings</a>
        <a href="#"         class="f-link">Necklaces</a>
        <a href="#"         class="f-link">Rings</a>
      </div>
      <div class="f-div">
        <h1>Contact Info</h1>
        <p><b>Phone:</b> +92 3390131721<br><b>Email:</b> adoreheaven26@gmail.com</p>
      </div>
      <div class="f-div">
        <h1>Help & Info</h1>
        <a href="#" class="f-link">About Us</a>
        <a href="#" class="f-link">Refund Policy</a>
        <a href="#" class="f-link">Privacy Policy</a>
      </div>
    </div>
  </footer>

  <a href="#"><span class="material-symbols-outlined" id="chat">Chat</span></a>
  <script src="/js/index.js"></script>
  <script>
    function applySort(value) {
      document.getElementById("hidden-sort").value = value;
      document.getElementById("filter-form").submit();
    }
  </script>
</body>
</html>
